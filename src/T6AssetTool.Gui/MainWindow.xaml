<Window x:Class="T6AssetTool.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Crybaby's IPAK Extractor" Width="1160" Height="760" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#070A0D" Foreground="#D9E2E5" FontFamily="Cascadia Mono,Consolas">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1116"/><Setter Property="Foreground" Value="#D5E0E3"/><Setter Property="BorderBrush" Value="#26343C"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="#4CD9CE"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#111A20"/><Setter Property="Foreground" Value="#EAB44B"/><Setter Property="BorderBrush" Value="#34464F"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="#738993"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="0,0,0,7"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#C8D5DA"/><Setter Property="Margin" Value="0,0,22,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CRYBABY'S IPAK EXTRACTOR" Foreground="#F0B74B" FontSize="27" FontWeight="Bold"/><TextBlock Text="XBOX 360  ·  BLACK OPS II  ·  GAME TEXTURE PACKAGES (.IPAK)" Foreground="#60747D" FontSize="12" Margin="1,8,0,0"/></StackPanel><Border Grid.Column="1" BorderBrush="#255D59" BorderThickness="1" Background="#0A1919" Padding="16,9" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#47D5C9" Width="8" Height="8" Margin="0,0,10,0"/><TextBlock x:Name="Status" Text="SYSTEM READY" Foreground="#47D5C9"/></StackPanel></Border></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="45*"/><ColumnDefinition Width="55*"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="19"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="19"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="19"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Content="01  MODE"/><StackPanel Grid.Row="1" Orientation="Horizontal"><RadioButton x:Name="ModeExtract" Content="EXTRACT   .IPAK → .DDS TEXTURES" IsChecked="True"/><RadioButton x:Name="ModeRepack" Content="REPACK   .DDS TEXTURES → .IPAK"/></StackPanel>
    <Label Grid.Row="3" Content="02  SOURCE .IPAK  (GAME TEXTURE PACKAGE)"/><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="IPak"/><Button x:Name="PickIPak" Grid.Column="1" Content="BROWSE"/></Grid>
    <Label x:Name="FolderLabel" Grid.Row="6" Content="03  FOLDER TO SAVE .DDS TEXTURES INTO"/><Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Output"/><Button x:Name="PickOutput" Grid.Column="1" Content="BROWSE"/></Grid>
    <Label x:Name="RepackOutLabel" Grid.Row="9" Content="04  REBUILT .IPAK TO WRITE" Visibility="Collapsed"/><Grid x:Name="RepackOutRow" Grid.Row="10" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RepackOut"/><Button x:Name="PickRepackOut" Grid.Column="1" Content="BROWSE"/></Grid>
    <Border x:Name="PolicyBox" Grid.Row="11" BorderBrush="#26343C" BorderThickness="1" Background="#0A0F13" Padding="13" VerticalAlignment="Top" Margin="0,19,0,0"><StackPanel><TextBlock x:Name="PolicyTitle" Text="WHAT THIS DOES" Foreground="#EAB44B" FontSize="11"/><TextBlock x:Name="PolicyText" Text="Rebuilds every texture in the package from its mip parts and writes them as named .dds files. Nothing but the .ipak itself is needed.&#10;&#10;The folder you pick is emptied before writing." Foreground="#81949C" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="18"/></StackPanel></Border>
    <Button x:Name="Execute" Grid.Row="12" Content="▶  EXTRACT TEXTURES" Background="#D99E35" Foreground="#071014" BorderBrush="#F3BD52" FontSize="15" Padding="20,14" Margin="0"/>
   </Grid>
   <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="4"/><RowDefinition Height="54"/></Grid.RowDefinitions><Label Content="PROGRESS LOG"/><TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#040709" Foreground="#72DCD4" FontSize="12"/><ProgressBar x:Name="Progress" Grid.Row="2" IsIndeterminate="False" Background="#172227" Foreground="#47D5C9"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" Text="AWAITING JOB" Foreground="#60747D" VerticalAlignment="Center"/><Button x:Name="OpenOutput" Grid.Column="1" Content="OPEN OUTPUT" VerticalAlignment="Center"/></Grid></Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#1C2930" BorderThickness="0,1,0,0" Margin="0,13,0,0"><Grid><TextBlock Text="NATIVE MANAGED LZO  ·  XENOS UNTILING  ·  BC1/BC3/BC5  ·  BYTE-EXACT REPACK" Foreground="#52656D" VerticalAlignment="Center"/><TextBlock Text="BUILD 01.03" Foreground="#52656D" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
